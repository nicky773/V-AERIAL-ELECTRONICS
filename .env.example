# Gmail SMTP. Create an app password in the Google account and place it only
# in your local .env file; never commit or share it.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=aerialelectronics0@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=AERIAL ELECTRONICS <aerialelectronics0@gmail.com>
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_SECONDS=60
